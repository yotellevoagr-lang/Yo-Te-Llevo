
rules_version = '2';

service cloud.firestore {
    match /databases/{database}/documents {

        // --- Helper Functions ---
        function isSignedIn() {
            return request.auth != null;
        }

        function isSignedInAsRole(role) {
            // Checks if the user is authenticated and has a document in the specified role collection.
            return isSignedIn() && exists(/databases/$(database)/documents/$(role)/$(request.auth.uid));
        }

        function isOwner(userId) {
            // Checks if the authenticated user's UID matches the document ID.
            return isSignedIn() && request.auth.uid == userId;
        }

        // --- Global Read Rules ---
        match /tours/{tourId} {
            allow read: if true;
            allow write: if isSignedInAsRole('admin');
        }
        match /flyers/{flyerId} { allow read: if true; allow write: if isSignedInAsRole('admin'); }
        match /settings/{settingId} { allow read: if true; allow write: if isSignedInAsRole('admin'); }
        match /boarding_points/{bpId} { allow read: if true; allow write: if isSignedInAsRole('admin'); }
        match /pensions/{pensionId} { allow read: if true; allow write: if isSignedInAsRole('admin'); }
        match /room_types/{rtId} { allow read: if true; allow write: if isSignedInAsRole('admin'); }

        // --- Chatbot Flow ---
        match /chatbot_flows/{nodeId} {
            allow read: if true;
            allow write: if isSignedInAsRole('admin');
        }

        // --- USER ROLES ---
        match /admin/{adminId} {
            allow read: if true;
            allow write: if isOwner(adminId);
        }

        // --- EMPLEADOS ---
        match /employees/{employeeId} {
            allow read: if true;
            allow create: if true;
            allow update: if isOwner(employeeId) || isSignedInAsRole('admin');
            allow delete: if isSignedInAsRole('admin');
        }
        
        // --- PASAJEROS (Clientes / Invitados) ---
        match /passengers/{passengerId} {
            allow read: if true;
            allow create: if true;
            // Allow anyone to update or delete. This is necessary for the registration flow
            // where a new auth user "claims" and replaces an old placeholder document.
            // App-side logic must be robust to prevent unauthorized modifications.
            allow update: if true;
            allow delete: if true;

             match /benefits/{benefitId} {
                allow read, write: if isOwner(passengerId);
            }
        }

        // --- RESERVAS ---
        match /reservations/{reservationId} {
            allow create: if true;
            allow read: if true;
            allow update, delete: if isSignedInAsRole('admin') || isSignedInAsRole('employee');
        }

        // --- VENDEDORES ---
        match /sellers/{sellerId} {
            allow read: if true;
            allow write: if isSignedInAsRole('admin');
        }

        // --- COLECCIONES FINANCIERAS ---
        match /transactions/{transactionId} {
            allow read, write: if isSignedInAsRole('admin') || isSignedInAsRole('employee');
        }
        match /custom_expenses/{expenseId} {
            allow read, write: if isSignedInAsRole('admin');
        }
        match /external_commissions/{commissionId} {
            allow read, write: if isSignedInAsRole('admin');
        }
        match /excursion_incomes/{incomeId} {
            allow read, write: if isSignedInAsRole('admin');
        }

        // --- EX EMPLEADOS ---
        match /ex_employees/{employeeId} {
            allow read, write: if isSignedInAsRole('admin');
        }
        
        // --- FCM TOKENS ---
        match /fcmTokens/{token} {
            // Anyone can write their own token. Reading should be restricted.
            allow write: if true;
            allow read: if isSignedInAsRole('admin');
        }
        
        // --- LOCATION VOTES ---
        match /location_votes/{voteId} {
            allow create: if true; // Anyone can create a vote
            allow read, delete: if isSignedInAsRole('admin'); // Only admins can see and manage votes
        }

        // --- Community ---
        match /community_posts/{postId} {
          allow read: if true;
          allow create, update, delete: if isSignedInAsRole('admin') || isSignedInAsRole('employee');
          
          match /comments/{commentId} {
            allow read: if true;
            allow create: if isSignedIn();
            allow update, delete: if isOwner(resource.data.userId) || isSignedInAsRole('admin') || isSignedInAsRole('employee');
          }
          match /reactions/{reactionId} {
            allow read: if true;
            allow write: if isSignedIn();
          }
        }
        
        // --- Benefits ---
        match /benefits/{benefitId} {
          allow read: if true;
          allow write: if isSignedInAsRole('admin');
        }
        match /benefit_redemptions/{redemptionId} {
          allow read: if isSignedInAsRole('admin') || isSignedInAsRole('employee');
          allow create: if isSignedIn();
          allow update, delete: if isSignedInAsRole('admin');
        }
    }
}
