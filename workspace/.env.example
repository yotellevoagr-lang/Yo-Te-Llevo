
# Firebase Client SDK Configuration (for the browser)
# These are safe to be public.
NEXT_PUBLIC_FIREBASE_API_KEY="AIza..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="1:your-app-id:web:..."

# Gemini API Key (for Genkit server-side calls)
# KEEP THIS SECRET. Do not commit it to your repository.
GEMINI_API_KEY="AIza..."

# Firebase Admin SDK Service Account Key (for server-side operations)
# THIS IS HIGHLY SENSITIVE. It gives full admin access to your Firebase project.
# 1. Go to Firebase Console > Project Settings > Service accounts.
# 2. Click "Generate new private key". A JSON file will download.
# 3. Open the JSON file, copy its entire content, and paste it here on a single line, enclosed in double quotes.
# Example: FIREBASE_SERVICE_ACCOUNT_KEY="{...}"
FIREBASE_SERVICE_ACCOUNT_KEY=""
