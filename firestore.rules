rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admin/$(request.auth.uid));
    }

    function isEmployee() {
      return isSignedIn() && exists(/databases/$(database)/documents/employees/$(request.auth.uid));
    }

    function isPassenger() {
      return isSignedIn() && exists(/databases/$(database)/documents/passengers/$(request.auth.uid));
    }

    function isAdminOrEmployee() {
      return isAdmin() || isEmployee();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ==========================================
    // PUBLIC DATA (lectura pública)
    // ==========================================
    
    match /tours/{tourId} {
      allow read: if true;
      allow write: if isAdminOrEmployee();
    }

    match /flyers/{flyerId} {
      allow read: if true;
      allow write: if isAdminOrEmployee();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /boarding_points/{bpId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pensions/{pensionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /room_types/{rtId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sellers/{sellerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // USER COLLECTIONS (para login/registro)
    // ==========================================

    match /admin/{adminId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isOwner(adminId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /employees/{employeeId} {
      allow read: if true;
      allow create: if true;
      allow update: if isOwner(employeeId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /passengers/{passengerId} {
      allow read: if true;
      allow create: if true;
      allow update: if isOwner(passengerId) || isAdminOrEmployee();
      allow delete: if isAdmin();

      match /benefits/{benefitId} {
        allow read: if isOwner(passengerId) || isAdminOrEmployee();
        allow write: if isSignedIn();
      }
    }

    match /ex_employees/{employeeId} {
      allow read, write: if isAdmin();
    }

    // ==========================================
    // RESERVATIONS
    // ==========================================

    match /reservations/{reservationId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdminOrEmployee();
    }

    // ==========================================
    // TICKETS
    // ==========================================

    match /tickets/{ticketId} {
      allow read: if isAdminOrEmployee() || isPassenger();
      allow create: if isAdminOrEmployee();
      allow update, delete: if isAdminOrEmployee();
    }

    // ==========================================
    // FINANCIAL (solo Admin)
    // ==========================================

    match /transactions/{transactionId} {
      allow read: if isAdminOrEmployee();
      allow write: if isAdmin();
    }

    match /custom_expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    match /external_commissions/{commissionId} {
      allow read, write: if isAdmin();
    }

    match /excursion_incomes/{incomeId} {
      allow read, write: if isAdmin();
    }

    // ==========================================
    // COMMUNITY (community_posts - snake_case)
    // ==========================================

    match /community_posts/{postId} {
      allow read: if true;
      allow create: if isAdminOrEmployee();
      allow update, delete: if isAdminOrEmployee();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update: if isOwner(resource.data.userId) || isAdminOrEmployee();
        allow delete: if isAdminOrEmployee();
      }

      match /reactions/{reactionId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // ==========================================
    // BENEFITS (benefits + benefit_redemptions)
    // ==========================================

    match /benefits/{benefitId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /benefit_redemptions/{redemptionId} {
      allow read: if isAdminOrEmployee() || (isSignedIn() && resource.data.passengerId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // CHATBOT
    // ==========================================

    match /chatbot_flows/{flowId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // VOTOS POR ZONA
    // ==========================================

    match /location_votes/{voteId} {
      allow read: if isAdminOrEmployee();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // FACTURAS ARCA
    // ==========================================

    match /invoices/{invoiceId} {
      allow read, write: if isAdmin();
    }

    // ==========================================
    // ANALYTICS & PRESENCE (nuevo)
    // ==========================================

    // Presencia: cualquiera puede escribir su sesión, admin/employee puede leer todas
    match /presence/{sessionId} {
      allow read: if isAdminOrEmployee();
      allow create, update: if true;
      allow delete: if isAdminOrEmployee();
    }

    // Vistas de página: cualquiera puede registrar una vista, solo admin/employee puede leerlas
    match /page_views/{viewId} {
      allow read: if isAdminOrEmployee();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
